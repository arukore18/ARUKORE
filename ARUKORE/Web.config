<?xml version="1.0"?>
<configuration>

	<!-- APPLICATION SETTINGS -->
	<appSettings file="AppSettingsSecrets.config">
		<add key="ValidationSettings:UnobtrusiveValidationMode"
             value="None"/>
	</appSettings>

	<!-- DATABASE CONNECTION -->
	<connectionStrings>
		<add name="ARUKORE_DB"
             connectionString="Data Source=ARUKORE-8055\SQLEXPRESS;Initial Catalog=ARUKORE_DB;Integrated Security=True;TrustServerCertificate=True"
             providerName="System.Data.SqlClient"/>
	</connectionStrings>

	<system.web>

		<!-- GLOBALIZATION -->
		<globalization
            fileEncoding="utf-8"
            requestEncoding="utf-8"
            responseEncoding="utf-8"
            culture="en-US"
            uiCulture="en-US"/>

		<!-- COMPILATION -->
		<compilation debug="true" targetFramework="4.8"/>

		<!-- HTTP RUNTIME -->
		<httpRuntime targetFramework="4.8"/>

		<!-- ASP.NET PAGES -->
		<pages controlRenderingCompatibilityVersion="4.0"/>

		<!-- TEMPORARY DETAILED ERROR REPORTING -->
		<customErrors mode="Off"/>

	</system.web>

	<system.webServer>

		<!-- TEMPORARY IIS DEBUGGING -->
		<httpErrors errorMode="Detailed"
                    existingResponse="PassThrough"/>

	</system.webServer>

</configuration>
